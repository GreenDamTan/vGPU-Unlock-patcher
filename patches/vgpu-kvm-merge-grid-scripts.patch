diff --git a/init-scripts/post-install b/init-scripts/post-install
--- a/init-scripts/post-install
+++ b/init-scripts/post-install
@@ -83,6 +83,15 @@

     . $current_path/common.sh

+    if [ "$install_target" = "systemd" ]; then
+        case "$(systemctl is-enabled "$nv_daemon_name.service" 2>/dev/null)" in
+            masked|masked-runtime)
+                printf "\n$nv_daemon_name.service is masked, preserving administrator setting.\n"
+                return 0
+                ;;
+        esac
+    fi
+
     # Run through the install steps now
     nv_printf "\n"
     nv_printf "Installation parameters:\n"
@@ -118,6 +127,28 @@
     run_install nvidia-vgpu-mgr 0 $tgt 1
 fi

+IS_GRID=$(( 1 ))
+if [ "$IS_GRID" = "1" ]; then
+    start_service=0
+    enable_service=1
+    grid_status=0
+    if nvidia-smi >/dev/null 2>&1; then
+        start_service=1
+    else
+        nv_printf "\nFew of the NVIIDA services will not be started."
+        nv_printf " It is strongly recommended that you reboot"
+        nv_printf " your computer after the installation is complete.\n"
+    fi
+
+    (run_install nvidia-persistenced $start_service $tgt $enable_service) || grid_status=1
+    (run_install nvidia-gridd $start_service $tgt $enable_service) || grid_status=1
+    if [ `uname -m` = "x86_64" ]; then
+        mkdir -p /var/run/nvidia-topologyd || grid_status=1
+        (run_install nvidia-topologyd $start_service $tgt $enable_service) || grid_status=1
+    fi
+    [ "$grid_status" -eq 0 ] || exit "$grid_status"
+fi
+
 #VGPU.RUN_SPECIFIC_CODE_START
 #VGPU.RUN_SPECIFIC_CODE_END

diff --git a/init-scripts/pre-uninstall b/init-scripts/pre-uninstall
--- a/init-scripts/pre-uninstall
+++ b/init-scripts/pre-uninstall
@@ -101,6 +101,14 @@
     printf "\n$nv_daemon_name $target successfully uninstalled.\n"
 }

+IS_GRID=$(( 1 ))
+if [ "$IS_GRID" = "1" ]; then
+    if [ `uname -m` = "x86_64" ]; then
+        run_uninstall nvidia-topologyd $tgt
+    fi
+    run_uninstall nvidia-gridd $tgt
+    run_uninstall nvidia-persistenced $tgt
+fi

 IS_VGX=$(( 1 || 1 || VGX_DEVICE_VM_BUILD ))
 if [ "$IS_VGX" = "1" ]; then
diff --git a/nvidia-bug-report.sh b/nvidia-bug-report.sh
